            {
              "@type": "Question",
              "name": "Neyroxirurg kim va Toshkentda qachon murojaat qilish kerak?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Neyroxirurg — miya, orqa miya, umurtqa va periferik nerv kasalliklarini davolaydi. NeurON (Toshkent) ga miya o‘smasi, anevrizma, umurtqa churrasi, uch shoxli nerv nevralgiyasi va farmakorezistent epilepsiya bilan murojaat qilishadi."
              }
            },
            {
              "@type": "Question",
              "name": "NeurON da neyroonologiya nimalarni o‘z ichiga oladi?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Neyroonologiya — meningioma, glioma, gipofiz adenomasi va boshqa markaziy asab tizimi o‘smalarini diagnostika va jarrohlik yo‘li bilan davolash (MRT reja, MSKT nazorat)."
              }
            },
            {
              "@type": "Question",
              "name": "Og‘riq markazida surunkali og‘riq qanday davolanadi?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Og‘riqni davolash markazi: epidural va davolash blokadalari, COSMAN G4 da radiochastotali ablyatsiya, nevropatik og‘riqda impulsli radiochastota — ko‘pincha umumiy narkozsiz."
              }
            },
            {
              "@type": "Question",
              "name": "Klinikada epilepsiya jarrohligi bormi?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Ha. Farmakorezistent epilepsiyada kompleks tekshiruvdan so‘ng epileptogen o‘choqni olib tashlash yoki ta’sir qilish ko‘rib chiqiladi."
              }
            }
