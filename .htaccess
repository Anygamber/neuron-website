# Merge these rules into the existing server .htaccess if cPanel already
# keeps a Passenger block there. Do not delete that block.
RewriteEngine On

# Leave real files and directories alone, including /analytics-x7k9m2p4q8w1n5v3/.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

RewriteRule ^analytics-x7k9m2p4q8w1n5v3(/|$) - [L]
