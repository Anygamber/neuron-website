# NeurON → Telegram bot (заявки на обратный звонок)
#
# 1) Создайте бота у @BotFather и вставьте токен
# 2) Напишите боту /start, узнайте свой chat_id (@userinfobot) — это TELEGRAM_CHAT_ID клиники
# 3) Сотрудники дополнительно подписываются командой /register в боте
#
TELEGRAM_BOT_TOKEN=PASTE_BOT_TOKEN_HERE
TELEGRAM_CHAT_ID=PASTE_ADMIN_CHAT_ID_HERE

# Bearer для внутренних вызовов бота (регистрация сотрудников / чат)
API_BEARER_TOKEN=neuron-booking-bearer-change-me

# Секрет для скрытой аналитики посещений
# Дашборд: /analytics-x7k9m2p4q8w1n5v3/?t=ЭТОТ_ТОКЕН
ANALYTICS_SECRET_TOKEN=change-me-to-long-random-string

BOOKING_API_URL=http://127.0.0.1:8000/api/submit-booking
CALLBACK_API_URL=http://127.0.0.1:8000/api/request-callback

HOST=127.0.0.1
PORT=8000

# Реквизиты клиники в тексте Telegram-заявок (опционально)
CLINIC_NAME=NeurON Medical Centre
CLINIC_LOCATION=Ташкент, Узбекистан
CLINIC_PHONE=+998 (71) 200-00-20
CLINIC_EMAIL=info@neuronmedical.uz
CLINIC_ADDRESS=Ташкент, Юнусабадский район, махалля Отчопар-2, 3-й проезд Чинабад, дом 2
CLINIC_SITE_URL=https://neuronmedical.uz/
